# ---------------------------------------------------------------------------
# Sasta Room API — environment variables
# Copy to .env for local development. In production set these in the hosting
# dashboard (Vercel → Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# MySQL / TiDB Cloud (Serverless)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=sasta_room
DB_USER=xxxxxxxx.root
DB_PASSWORD=change_me
# TiDB Cloud and most managed MySQL need TLS. Set to false for a local MariaDB.
DB_SSL=true

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin login created/updated by `npm run migrate`
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_min_8_chars

# Where new-lead emails go (booking requests, contact form). Defaults to ADMIN_EMAIL.
NOTIFY_EMAIL=

# Optional outbound email (leave SMTP_HOST empty to disable notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Browser origins allowed to call the API. Not needed when the Angular app is
# served from the same domain (the default Vercel setup).
FRONTEND_URL=http://localhost:4200
PROD_FRONTEND_URL=
CORS_ORIGINS=

# Uploads: max bytes per photo accepted before server-side resize
MAX_FILE_SIZE=8388608
